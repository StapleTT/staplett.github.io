---
import type { Project } from '../site';

interface Props { project: Project }
const { project: p } = Astro.props;
---
{p.data.cover && (
  <div class="cover" style={`view-transition-name: cover-${p.id}`}>
    <img src={p.data.cover} alt={p.data.coverAlt ?? ''} loading="lazy" decoding="async" />
  </div>
)}
