---
import { hasPage, projectHref, type Project } from '../site';
import Cover from './Cover.astro';

interface Props { project: Project; headingLevel?: 'h2' | 'h3' }
const { project: p, headingLevel: H = 'h3' } = Astro.props;
const href = projectHref(p);
---
<a class="card" href={href} style={`view-transition-name: card-${p.id}`}>
  <Cover project={p} />
  <div class="card-body">
    <div class="card-head">
      <H class="card-title" style={`view-transition-name: title-${p.id}`}>{p.data.title}</H>
      {!hasPage(p) && <span class="card-host">{new URL(href).hostname}</span>}
    </div>
    <p class="card-summary">{p.data.summary}</p>
    {p.data.stack.length > 0 && <p class="card-stack">{p.data.stack.join(', ')}</p>}
  </div>
</a>
