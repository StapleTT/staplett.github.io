---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { CATEGORIES } from '../../content.config';
import { getProjects } from '../../site';

const projects = await getProjects();
---
<Base title="Projects" description="Everything Staple has built: security tooling, self-hosted apps, dotfiles, and game mods.">
  <div class="wrap page-head">
    <h1>Projects</h1>
    <p>Security tooling, self-hosted apps, and the dotfiles holding it all together.</p>
  </div>
  <section class="wrap page-content">
    <div class="chips" role="group" aria-label="Filter by category" hidden>
      <button class="chip" type="button" aria-pressed="true" data-filter="all">All</button>
      {CATEGORIES.map((c) => <button class="chip" type="button" aria-pressed="false" data-filter={c}>{c}</button>)}
    </div>
    <p class={projects.length ? 'visually-hidden' : undefined} role="status" id="filter-status">{!projects.length && 'No projects to show yet.'}</p>
    <ul class="grid" id="project-grid">
      {projects.map((p) => (
        <li data-categories={JSON.stringify(p.data.categories)}><ProjectCard project={p} headingLevel="h2" /></li>
      ))}
    </ul>
  </section>
</Base>

<script>
  // Filter chips. View Transitions animate the reorder (FLIP) using each card's view-transition-name.
  const items = [...document.querySelectorAll<HTMLLIElement>('#project-grid > li')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const filters = document.querySelector<HTMLElement>('.chips')!;
  const status = document.getElementById('filter-status')!;
  let requested = 'all';

  function apply(filter: string) {
    let shown = 0;
    for (const li of items) {
      const ok = filter === 'all' || JSON.parse(li.dataset.categories!).includes(filter);
      li.hidden = !ok;
      if (ok) shown++;
    }
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));
    status.classList.toggle('visually-hidden', shown > 0);
    status.textContent = shown === 0 ? 'No projects in this category. Choose All to see every project.'
      : shown === 1 ? '1 project shown' : `${shown} projects shown`;
  }

  chips.forEach((chip) => chip.addEventListener('click', () => {
    const f = requested = chip.dataset.filter!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (document.startViewTransition && !reduce) {
      const transition = document.startViewTransition(() => { if (requested === f) apply(f); });
      void transition.ready.catch(() => {}); // A newer choice can skip this animation.
    } else apply(f);
  }));
  if (items.length) filters.hidden = false;
</script>
