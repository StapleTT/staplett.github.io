---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PUBLIC_REPOS, SKILLS, getProjects } from '../site';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const strip = ['Python', 'TypeScript', 'Go', 'Bash', 'React', 'Fastify', 'PostgreSQL', 'Linux', 'Proxmox VE', 'Docker', 'NGINX', 'WireGuard', 'OAuth 2.0', 'TShark'];
---
<Base>
  <section class="hero">
    <canvas aria-hidden="true"></canvas>
    <div class="wrap hero-inner">
      <img class="avatar" src="/avatar.webp" alt="Staple's illustrated avatar" width="168" height="168" />
      <div>
        <p class="label">hi, I'm</p>
        <h1>Staple<span>.</span></h1>
        <p>Cybersecurity, self-hosting, and tiny computers.</p>
        <div class="actions">
          <a class="btn primary" href="/projects/">See projects</a>
          <a class="btn" href="/contact/">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head reveal">
      <h2>Featured projects</h2>
      <a href="/projects/">All projects →</a>
    </div>
    <ul class="grid">
      {featured.map((p) => <li class="reveal"><ProjectCard project={p} /></li>)}
    </ul>
  </section>

  <section class="section wrap about-teaser">
    <div class="reveal">
      <p class="label">about</p>
      <h2 class="section-title">Who's asking?</h2>
      <p class="muted" style="margin-top:1rem">
        I'm a high school student in the US, studying computer science and cybersecurity in a career-tech program.
        Most of my free time goes into my homelab, security tooling, and building small form factor PCs. I like taking
        things apart to see how they break, then building them back up so they don't.
      </p>
      <div class="stats">
        <div class="stat"><b data-count={PUBLIC_REPOS}>{PUBLIC_REPOS}</b><span>public repos</span></div>
        <div class="stat"><b data-count={projects.length}>{projects.length}</b><span>projects here</span></div>
        <div class="stat"><b data-count={SKILLS.Languages.length}>{SKILLS.Languages.length}</b><span>languages</span></div>
      </div>
      <p style="margin-top:2rem"><a href="/about/">More about me →</a></p>
    </div>
    <ul class="facts reveal">
      <li><b>focus</b>cybersecurity, self-hosting, Linux</li>
      <li><b>currently building</b>Spindle, tack</li>
      <li><b>daily driver</b>Arch + Hyprland</li>
      <li><b>also</b>SFF PC builds, Beat Saber, clarinet</li>
    </ul>
  </section>

  <section class="section wrap">
    <div class="section-head reveal"><h2>Things I work with</h2><a href="/about/#skills">Full list →</a></div>
    <ul class="skills-strip reveal">{strip.map((s) => <li>{s}</li>)}</ul>
  </section>
</Base>

<script>
  import '../scripts/hero';
</script>
