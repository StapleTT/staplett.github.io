---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../site';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const skills: [string, string][] = [
  ['Languages', 'Python, TypeScript, Go, Bash'],
  ['Web and data', 'React, Fastify, PostgreSQL'],
  ['Systems', 'Linux, Proxmox VE, Docker'],
  ['Security', 'NGINX, WireGuard, TLS, OAuth 2.0, TShark'],
];
---
<Base>
  <section class="hero">
    <canvas aria-hidden="true"></canvas>
    <div class="wrap hero-inner">
      <h1>Staple<span>.</span></h1>
      <p>Cybersecurity, <span>self-hosting</span>, and tiny computers.</p>
      <div class="actions">
        <a class="btn primary" href="/projects/">Browse projects</a>
        <a class="btn" href="/contact/">Contact</a>
      </div>
      <img class="avatar" src="/avatar.webp" alt="Staple's illustrated avatar" width="320" height="320" />
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head"><h2>Featured projects</h2></div>
    <ul class="grid">
      {featured.map((p) => <li><ProjectCard project={p} /></li>)}
    </ul>
  </section>

  <div class="wrap home-notes">
    <section>
      <h2 class="section-title">Who's asking?</h2>
      <p class="muted">
        I'm a high school student in the US, studying computer science and cybersecurity in a career-tech program.
        I like taking things apart to see how they break, then building them back up so they don't.
      </p>
      <p><a href="/about/">More about me →</a></p>
    </section>
    <section>
      <h2 class="section-title">Things I work with</h2>
      <dl class="skills">
        {skills.map(([group, items]) => <div><dt>{group}</dt><dd>{items}</dd></div>)}
      </dl>
      <p><a href="/about/#skills">Full skills list →</a></p>
    </section>
  </div>
</Base>

<script>
  import '../scripts/hero';
</script>
